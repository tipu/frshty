# Per-account host aliases belong to the host, not to this repository. Put
# them in ~/.ssh/config.d/, which docker-compose mounts at /tmp/.ssh-host.
Include /tmp/.ssh-host/config.d/*

Host github-personal
    HostName github.com
    User git
    IdentityFile /tmp/.ssh-host/id_ed25519
    IdentitiesOnly yes

Host bitbucket.org
    IdentityFile /tmp/.ssh-host/id_ed25519
    IdentitiesOnly yes

Host *
    UserKnownHostsFile /tmp/.ssh-host/known_hosts
    StrictHostKeyChecking no
